{
  "name": "asterium-desktop",
  "productName": "Asterium Beta",
  "version": "0.1.0-beta.4",
  "description": "星丛 Asterium 多 AI 桌面工作台",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build --config vite.renderer.config.ts --outDir ../../.vite/renderer-check",
    "build:studio-wake": "vite build --config vite.studio-wake.config.ts",
    "build:automation-adapter": "vite build --config vite.automation-adapter.config.ts",
    "test:automation-adapter": "node tests/automation-adapter-acceptance.mjs --mock",
    "test:studio-wake-adapter": "node tests/studio-wake-adapter-acceptance.mjs --mock",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cleanup": "node scripts/cleanup-autotest.mjs",
    "package": "electron-forge package",
    "test:startup": "node tests/electron-startup-smoke.mjs",
    "test:profile-isolation": "node tests/profile-isolation-smoke.mjs",
    "test:memory-sqlite": "node tests/memory-sqlite-startup-smoke.mjs",
    "memory:sqlite": "node scripts/memory-sqlite-maintenance.mjs",
    "test:extensions": "node tests/api-extensions-acceptance.mjs",
    "test:extensions:live": "node tests/api-extensions-acceptance.mjs --live",
    "check:capabilities": "node scripts/check-capabilities.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "sandbox:s1": "node tools/sandbox-s1/runner.mjs",
    "sandbox:s1:build": "node tools/sandbox-s1/runner.mjs --build",
    "sandbox:s1:status": "node tools/sandbox-s1/runner.mjs --status",
    "sandbox:s1:verify": "node tools/sandbox-s1/acceptance.mjs",
    "sandbox:s1:test-status": "node tools/sandbox-s1/runner.mjs --status --test-launcher",
    "sandbox:s1:test-verify": "node tools/sandbox-s1/acceptance.mjs --test-launcher",
    "sandbox:s1:identity-verify": "node tools/sandbox-s1/identity-acceptance.mjs --test-launcher",
    "sandbox:build": "node scripts/build-windows-sandbox.mjs",
    "test:api-providers": "node tests/api-providers-acceptance.mjs",
    "test:empty-start": "node tests/empty-start-browser-smoke.mjs",
    "build:claude-bridge": "node scripts/build-claude-bridge.mjs",
    "test:claude-cli": "node tests/claude-cli-acceptance.mjs",
    "build:candidate": "node scripts/build-windows-candidate.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "lucide-react": "1.42.0",
    "mammoth": "1.12.3",
    "mermaid": "^12.1.0",
    "pdfjs-dist": "^5.4.149",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.3",
    "remark-gfm": "^4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.2.0",
    "electron-builder": "26.18.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "playwright-core": "1.58.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "author": "ZoeLeeLab",
  "license": "MPL-2.0"
}
